            "hacker"
          ],
          "default": "step",
          "description": "'step': each advance (Alt+N) types the next line by itself. 'hacker': advance arms the cell; then every key you press types the next few characters of the script (Esc disarms)."
        },
        "clmTyping.charsPerSecond": {
          "type": "number",
          "default": 22,
          "description": "Step mode: typing speed (characters per second)."
        },
        "clmTyping.jitter": {
          "type": "number",
          "default": 0.6,
          "description": "Step mode: random speed variation (0 = metronome, 0.6 = uneven)."
        },
        "clmTyping.selectionPauseMs": {
          "type": "number",
          "default": 450,
          "description": "Step mode: how long a selection is shown before it is deleted (ms)."
        },
        "clmTyping.hackerMinChars": {
          "type": "integer",
          "default": 1,
          "description": "Hacker mode: minimum characters per key press."
        },
        "clmTyping.hackerMaxChars": {
          "type": "integer",
          "default": 3,
          "description": "Hacker mode: maximum characters per key press."
        },
        "clmTyping.showIndicator": {
          "type": "boolean",
          "default": true,
          "description": "Highlight the cell and show a status bar item while hacker mode is armed."
        }
      }
    }
