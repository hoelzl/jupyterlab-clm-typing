{
  "name": "clm-typing",
  "displayName": "CLM Typing Replay",
  "description": "Spike: replay code-along -> completed cell edits as simulated typing (CLM recording notebooks).",
  "version": "0.1.2",
  "publisher": "hoelzl",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/hoelzl/jupyterlab-clm-typing.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Notebooks",
    "Education"
  ],
  "activationEvents": [
    "onNotebook:jupyter-notebook"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "clmTyping.advance",
        "title": "Advance (step) / arm or disarm (hacker)",
        "category": "CLM Typing"
      },
      {
        "command": "clmTyping.finish",
        "title": "Finish cell now",
        "category": "CLM Typing"
      },
      {
        "command": "clmTyping.undoStep",
        "title": "Undo last step",
        "category": "CLM Typing"
      },
      {
        "command": "clmTyping.reset",
        "title": "Reset cell to its start",
        "category": "CLM Typing"
      },
      {
        "command": "clmTyping.toggleMode",
        "title": "Toggle step/hacker mode",
        "category": "CLM Typing"
      },
      {
        "command": "clmTyping.disarm",
        "title": "Disarm hacker mode",
        "category": "CLM Typing"
      },
      {
        "command": "clmTyping.hackerKey",
        "title": "Hacker key press",
        "category": "CLM Typing"
      },
      {
        "command": "clmTyping.commandModeKey",
        "title": "Hacker key press in command mode",
        "category": "CLM Typing"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "clmTyping.hackerKey",
          "when": "false"
        },
        {
          "command": "clmTyping.disarm",
          "when": "clmTyping.armed"
        },
        {
          "command": "clmTyping.commandModeKey",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "clmTyping.advance",
        "key": "alt+n",
        "when": "notebookEditorFocused"
      },
      {
        "command": "clmTyping.finish",
        "key": "alt+shift+n",
        "when": "notebookEditorFocused"
      },
      {
        "command": "clmTyping.undoStep",
        "key": "alt+shift+u",
        "when": "notebookEditorFocused"
      },
      {
        "command": "clmTyping.reset",
        "key": "alt+shift+r",
        "when": "notebookEditorFocused"
      },
      {
        "command": "clmTyping.toggleMode",
        "key": "alt+shift+m",
        "when": "notebookEditorFocused"
      },
      {
        "command": "clmTyping.disarm",
        "key": "escape",
        "when": "clmTyping.armed"
      },
      {
        "command": "clmTyping.hackerKey",
        "key": "enter",
        "when": "clmTyping.armed && editorTextFocus"
      },
      {
        "command": "clmTyping.hackerKey",
        "key": "backspace",
        "when": "clmTyping.armed && editorTextFocus"
      },
      {
        "command": "clmTyping.hackerKey",
        "key": "delete",
        "when": "clmTyping.armed && editorTextFocus"
      },
      {
        "command": "clmTyping.hackerKey",
        "key": "tab",
        "when": "clmTyping.armed && editorTextFocus"
      },
      {
        "command": "clmTyping.hackerKey",
        "key": "shift+tab",
        "when": "clmTyping.armed && editorTextFocus"
      },
      {
        "command": "clmTyping.hackerKey",
        "key": "left",
